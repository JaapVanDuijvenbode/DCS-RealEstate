# Copy to .env.local for local development. In Vercel, add the same keys under
# Project Settings > Environment Variables. Never commit real values.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://qnekbkhantxjnetelgmt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the app (used in QR codes and e-mail links)
NEXT_PUBLIC_APP_URL=https://move.layeredcake.ai

# Random secrets, 32+ bytes each. Generate with: openssl rand -hex 32
DEVICE_COOKIE_SECRET=
OTP_SECRET=

# Resend (sign-in codes). Without a key in development, codes are printed to the server log.
RESEND_API_KEY=
MAIL_FROM=LayeredCake MOVE <noreply@layeredcake.ai>
